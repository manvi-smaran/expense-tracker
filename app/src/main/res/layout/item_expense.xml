<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PetOS.Label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.PetOS.Body"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textCategory"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:paddingVertical="3dp"
        android:textAppearance="@style/TextAppearance.PetOS.Label"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/textItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.PetOS.Body"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/textCost"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.PetOS.Label"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_edit"
        android:contentDescription="Edit expense"
        android:padding="8dp"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_icon_delete"
        android:contentDescription="Delete expense"
        android:padding="8dp"
        android:src="@drawable/ic_delete" />
</LinearLayout>