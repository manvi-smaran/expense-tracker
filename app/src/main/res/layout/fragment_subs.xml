<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <!-- toast banner -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="10dp"
                android:textAppearance="@style/TextAppearance.PetOS.Label"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bannerClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="Dismiss"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textAppearance="@style/TextAppearance.PetOS.Label" />
        </LinearLayout>

        <!-- RECURRING MANAGER -->
        <LinearLayout
            style="@style/Widget.PetOS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECURRING MANAGER"
                    android:textAppearance="@style/TextAppearance.PetOS.Title"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_teal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="0 ACTIVE"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Monthly Burn Rate:"
                    android:textAppearance="@style/TextAppearance.PetOS.Body"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textBurn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00/MO"
                    android:textAppearance="@style/TextAppearance.PetOS.Title"
                    android:textColor="@color/primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ADD SUBSCRIPTION (collapsible) -->
        <LinearLayout
            style="@style/Widget.PetOS.Window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_titlebar_pink"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ADD SUBSCRIPTION"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnToggleForm"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Show or hide the form"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="▲"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVICE / PLAN NAME"
                    android:textAppearance="@style/TextAppearance.PetOS.Label" />

                <EditText
                    android:id="@+id/inputName"
                    style="@style/Widget.PetOS.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autofillHints="none"
                    android:hint="e.g. Netflix, Spotify, Gym"
                    android:inputType="textCapWords"
                    android:maxLength="100" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AMOUNT ($)"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <EditText
                            android:id="@+id/inputAmount"
                            style="@style/Widget.PetOS.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autofillHints="none"
                            android:hint="15.99"
                            android:inputType="numberDecimal"
                            android:maxLength="12" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CATEGORY"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <Spinner
                                android:id="@+id/spinnerCategory"
                                style="@style/Widget.PetOS.Spinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="▼"
                                android:textColor="@color/primary_dark"
                                android:textSize="10sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FREQUENCY"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <Spinner
                                android:id="@+id/spinnerFrequency"
                                style="@style/Widget.PetOS.Spinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="▼"
                                android:textColor="@color/primary_dark"
                                android:textSize="10sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXT DUE"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <TextView
                            android:id="@+id/textDueDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingHorizontal="12dp"
                            android:textAppearance="@style/TextAppearance.PetOS.Body"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/formMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textColor="@color/red"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAdd"
                    style="@style/Widget.PetOS.Button.Plum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="52dp"
                    android:text="+ ADD SUBSCRIPTION" />
            </LinearLayout>
        </LinearLayout>

        <!-- PROCESS DUE + DELETE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProcess"
                style="@style/Widget.PetOS.Button.Teal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="PROCESS DUE ($0.00)"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteSelected"
                style="@style/Widget.PetOS.Button.Red"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DELETE (0)"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- the list -->
        <TextView
            android:id="@+id/textLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="LOADING SUBSCRIPTIONS..."
            android:textAppearance="@style/TextAppearance.PetOS.Label" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listSubs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyState"
            style="@style/Widget.PetOS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Empty floppy disk"
                android:src="@drawable/ic_floppy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="NO RECURRING PAYMENTS"
                android:textAppearance="@style/TextAppearance.PetOS.Title"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Add a subscription above and I'll remind you when it's due."
                android:textAppearance="@style/TextAppearance.PetOS.Body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.PetOS.Label"
                android:textColor="@color/red" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                style="@style/Widget.PetOS.Button.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="RETRY" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>