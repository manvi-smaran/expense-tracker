<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.PetOS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="14dp">

    <CheckBox
        android:id="@+id/checkSelect"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:buttonTint="@color/primary_dark"
        android:contentDescription="Select category" />

    <ImageView
        android:id="@+id/iconTile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Category icon"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.PetOS.Title"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_chip_light"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textAppearance="@style/TextAppearance.PetOS.Label"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/textStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textAppearance="@style/TextAppearance.PetOS.Body"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_edit"
        android:contentDescription="Edit category"
        android:padding="8dp"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_icon_delete"
        android:contentDescription="Delete category"
        android:padding="8dp"
        android:src="@drawable/ic_delete" />
</LinearLayout>