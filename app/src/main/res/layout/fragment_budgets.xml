<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp">

        <!-- Budget Watchdog banner -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingVertical="10dp">

                <TextView
                    android:id="@+id/bannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget Alert"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/bannerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.PetOS.Body"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/bannerClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="Dismiss"
                android:focusable="true"
                android:gravity="center"
                android:text="X"
                android:textAppearance="@style/TextAppearance.PetOS.Label" />
        </LinearLayout>

        <!-- New Budget -->
        <LinearLayout
            style="@style/Widget.PetOS.Window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_titlebar_pink"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="New Budget"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/green"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="●"
                    android:textColor="@color/amber_dark"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="●"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORY SELECT"
                    android:textAppearance="@style/TextAppearance.PetOS.Label" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        style="@style/Widget.PetOS.Spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="▼"
                        android:textColor="@color/primary_dark"
                        android:textSize="10sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIMIT ($)"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <EditText
                            android:id="@+id/inputLimit"
                            style="@style/Widget.PetOS.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autofillHints="none"
                            android:hint="250"
                            android:inputType="numberDecimal"
                            android:maxLength="12" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALERT (%)"
                            android:textAppearance="@style/TextAppearance.PetOS.Label" />

                        <EditText
                            android:id="@+id/inputAlert"
                            style="@style/Widget.PetOS.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:autofillHints="none"
                            android:hint="80"
                            android:inputType="number"
                            android:maxLength="3" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/formMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.PetOS.Button.Pink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="52dp"
                    android:text="SAVE BUDGET" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Budgets -->
        <LinearLayout
            style="@style/Widget.PetOS.Window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_titlebar_teal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Active Budgets"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 ACTIVE"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/textLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Loading budgets..."
                    android:textAppearance="@style/TextAppearance.PetOS.Label" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listBudgets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="Empty floppy disk"
                        android:src="@drawable/ic_floppy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="NO BUDGETS YET"
                        android:textAppearance="@style/TextAppearance.PetOS.Title"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Pick a category above and set a limit. The watchdog will keep an eye on it for you."
                        android:textAppearance="@style/TextAppearance.PetOS.Body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/errorState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.PetOS.Label"
                        android:textColor="@color/red" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRetry"
                        style="@style/Widget.PetOS.Button.Light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="RETRY" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BUDDY_BOT SAYS -->
        <LinearLayout
            style="@style/Widget.PetOS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_tile_pink"
                android:contentDescription="Buddy Bot"
                android:padding="12dp"
                android:src="@drawable/ic_paw" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUDDY BOT SAYS:"
                    android:textAppearance="@style/TextAppearance.PetOS.Label"
                    android:textColor="@color/primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/textBuddy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.PetOS.Body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>