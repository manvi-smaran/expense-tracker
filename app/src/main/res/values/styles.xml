<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Text ===== -->
    <style name="TextAppearance.PetOS" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_body</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.PetOS.Body" parent="TextAppearance.PetOS" />

    <style name="TextAppearance.PetOS.Label" parent="TextAppearance.PetOS">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PetOS.Title" parent="TextAppearance.PetOS">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PetOS.NavLabel" parent="TextAppearance.PetOS">
        <item name="android:textColor">@color/primary_dark</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Cards and windows ===== -->
    <style name="Widget.PetOS.Card" parent="">
        <item name="android:background">@drawable/bg_card_light</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- A window with a title bar: children sit inside the 1dp outline -->
    <style name="Widget.PetOS.Window" parent="">
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:padding">1dp</item>
    </style>

    <!-- ===== Buttons (use with androidx.appcompat.widget.AppCompatButton) ===== -->
    <style name="Widget.PetOS.Button" parent="Widget.AppCompat.Button">
        <item name="android:textAppearance">@style/TextAppearance.PetOS.Label</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <!-- Filled primary action -->
    <style name="Widget.PetOS.Button.Yellow">
        <item name="android:background">@drawable/bg_button_yellow</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="Widget.PetOS.Button.Plum">
        <item name="android:background">@drawable/bg_button_plum</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- Filled destructive action -->
    <style name="Widget.PetOS.Button.Red">
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- Filled positive action -->
    <style name="Widget.PetOS.Button.Teal">
        <item name="android:background">@drawable/bg_button_teal</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- Tonal secondary actions -->
    <style name="Widget.PetOS.Button.Light">
        <item name="android:background">@drawable/bg_button_light</item>
    </style>
    <style name="Widget.PetOS.Button.Pink">
        <item name="android:background">@drawable/bg_button_pink</item>
    </style>
    <style name="Widget.PetOS.Button.Tab">
        <item name="android:background">@drawable/bg_button_tab</item>
        <item name="android:textColor">@color/btn_tab_text</item>
    </style>

    <!-- ===== Text input ===== -->
    <style name="Widget.PetOS.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textAppearance">@style/TextAppearance.PetOS.Body</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Widget.PetOS.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:popupBackground">@drawable/bg_card_white</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingEnd">28dp</item>
    </style>

    <!-- ===== Bottom navigation: the active tab gets a soft indigo pill ===== -->
    <style name="Widget.PetOS.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/white</item>
        <item name="elevation">8dp</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemBackground">@drawable/bg_nav_item</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.PetOS.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.PetOS.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.PetOS.NavLabel</item>
        <item name="itemPaddingTop">8dp</item>
        <item name="itemPaddingBottom">8dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.PetOS.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

</resources>
