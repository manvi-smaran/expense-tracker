<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: clip children to the rounded card outline -->
    <style name="Widget.PetOS.Card" parent="">
        <item name="android:background">@drawable/bg_card_light</item>
        <item name="android:padding">16dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Widget.PetOS.Window" parent="">
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:padding">1dp</item>
        <item name="android:clipToOutline">true</item>
    </style>
</resources>
